# Gandhigram Rural Institute (GRI) Mobile Portal — Supabase Cloud Backend Configuration
#
# This is a Flutter application: credentials are passed at build/run time with
# --dart-define (NOT a .env file, and NOT Vite-style variables).
#
# Obtain these credentials from your Supabase Dashboard:
# 1. Go to https://supabase.com/dashboard/project/<your-project-ref>/settings/api
# 2. Copy "Project URL"      -> SUPABASE_URL
# 3. Copy "anon public" key  -> SUPABASE_ANON_KEY
# Note: NEVER expose the service_role key to the client. Without these defines
# the app runs in offline-vault mode (fully functional, local persistence only).

# Names and example values (replace with your own project's values):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Run / build with cloud sync enabled:
#   flutter run --dart-define=SUPABASE_URL=https://your-project-ref.supabase.co --dart-define=SUPABASE_ANON_KEY=<anon-key>
#   flutter build apk --release --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...

# Database schema is provisioned with (in order):
#   supabase/migrations/20261004000000_init_gri_cloud.sql
#   supabase/migrations/20261004010000_gri_official_content.sql
#   supabase/migrations/20261028000000_document_certificates_and_applications.sql
#   supabase/migrations/20261028010000_rls_hardening.sql
#   supabase/migrations/20261028120000_attendance_registers.sql
